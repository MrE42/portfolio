---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Elijah Schoneweis | Software Engineer',
	description = 'Software engineer building gameplay systems, scientific tools, and applied AI. Creator of the RiskOfImpact mod for Risk of Rain 2.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#080709" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700;1,800&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

	:root {
		color-scheme: dark;
		font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
		background: #080709;
		color: #f2eee7;
		font-synthesis: none;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		scroll-behavior: smooth;
	}

	body {
		overflow-x: hidden;
	}

	button,
	a {
		font: inherit;
	}

	a {
		color: inherit;
	}

	::selection {
		background: #c7ff1a;
		color: #080709;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
