	.section-heading h2 span { color: #667478; }
	.project-intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 130px); max-width: 960px; margin: 0 0 64px auto; }
	.project-intro p { margin: 0; color: #94a0a3; font-size: 15px; line-height: 1.85; }
	.project-intro .lead { color: #d5dcde; font-size: 20px; line-height: 1.6; }

	.loadout { padding: 24px; border: 1px solid var(--line); background: rgba(16, 23, 25, 0.65); }
	.loadout-header { padding-bottom: 20px; border-bottom: 1px solid var(--line); }
	.item-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
	.item { position: relative; min-width: 0; padding: 23px 13px 18px; border-right: 1px solid var(--line); text-align: center; }
	.item:last-child { border: 0; }
	.item-number { position: absolute; top: 8px; left: 9px; color: #536064; font: 400 8px var(--mono); }
	.item-image { display: grid; place-items: center; width: min(100%, 104px); aspect-ratio: 1; margin: 0 auto 13px; border: 1px solid color-mix(in srgb, var(--rarity) 40%, transparent); background: radial-gradient(circle, color-mix(in srgb, var(--rarity) 18%, transparent), transparent 68%); clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px); transition: box-shadow 180ms ease, border-color 180ms ease; }
	.item:hover .item-image { box-shadow: 0 0 25px color-mix(in srgb, var(--rarity) 30%, transparent); border-color: var(--rarity); }
	.item-image img { width: 72%; height: 72%; object-fit: contain; filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.45)); transition: transform 180ms ease; }
	.item:hover .item-image img { transform: translateY(-4px) scale(1.06); }
	.item strong { display: block; overflow: hidden; color: #dce3e4; font: 600 11px var(--display); text-overflow: ellipsis; white-space: nowrap; }
	.item-type { display: block; margin-top: 5px; color: var(--rarity); font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: 0.07em; }
	.uncommon { --rarity: #8edf75; }
	.legendary { --rarity: #ff6653; }
	.void { --rarity: #c383e8; }
	.lunar { --rarity: #82c8ff; }
	.equipment { --rarity: #ffab45; }

	.systems { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 70px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.systems article { padding: 36px 34px 38px; border-right: 1px solid var(--line); transition: background 180ms ease; position: relative; overflow: hidden; }
	.systems article::before { content: ''; position: absolute; top: 0; left: 0; width: 2px; height: 0; background: var(--acid); transition: height 300ms ease; }
	.systems article:hover::before { height: 100%; }
	.systems article:hover { background: rgba(255, 255, 255, 0.015); }
	.systems article:first-child { padding-left: 0; }
	.systems article:last-child { border: 0; }
	.system-index { color: var(--acid); font: 400 10px var(--mono); letter-spacing: 0.06em; }
	.systems h3 { margin: 28px 0 15px; font: 600 23px var(--display); letter-spacing: -0.03em; color: #dce3e4; }
	.systems p { min-height: 78px; margin: 0; color: #9da8ab; font-size: 13px; line-height: 1.75; }
	.tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 24px; }
	.tags span { padding: 6px 8px; border: 1px solid var(--line); color: #849196; font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
	.project-link { display: flex; align-items: center; justify-content: space-between; margin-top: 45px; padding: 20px 22px; border: 1px solid var(--line); color: #dce3e4; font: 500 12px var(--mono); text-decoration: none; text-transform: uppercase; letter-spacing: 0.07em; transition: background 180ms ease, border-color 180ms ease; }
	.project-link:hover { border-color: var(--acid); background: rgba(217, 255, 67, 0.04); }
	.project-link .arrow { color: var(--acid); font-size: 20px; }

	.selected-work { padding: 130px 0 145px; border-top: 1px solid var(--line); }
	.work-list { display: grid; gap: 38px; }
	.work-story { overflow: hidden; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(18, 27, 30, 0.82), rgba(9, 13, 15, 0.94)); }
	.work-meta { display: flex; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--line); color: #657378; font: 500 9px var(--mono); letter-spacing: 0.11em; }
	.released { color: #aeb9bb; }
	.released i { display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 8px var(--acid); }
	.work-layout { display: grid; grid-template-columns: minmax(0, 0.88fr) minmax(430px, 1.12fr); min-height: 570px; }
	.work-layout.reverse { grid-template-columns: minmax(430px, 1.12fr) minmax(0, 0.88fr); }
	.work-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(40px, 5vw, 76px); }
	.work-layout:not(.reverse) .work-copy { border-right: 1px solid var(--line); }
	.work-layout.reverse .work-copy { border-left: 1px solid var(--line); }
	.work-kicker { margin: 0 0 21px; color: var(--orange); font: 500 9px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; }
	.work-copy h3 { margin: 0 0 28px; font: 600 clamp(39px, 4.8vw, 70px)/0.95 var(--display); letter-spacing: -0.055em; }
	.work-copy .work-lead { margin: 0 0 19px; color: #d6dddf; font-size: 18px; line-height: 1.58; }
	.work-copy > p:not(.work-kicker, .work-lead) { margin: 0; color: #8f9da0; font-size: 13px; line-height: 1.82; }
	.story-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 28px; }
	.story-tags span { padding: 6px 8px; border: 1px solid var(--line); color: #849196; font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
	.inline-link { margin-top: 28px; color: #cdd5d7; font: 500 10px var(--mono); text-decoration-color: #536063; text-underline-offset: 6px; text-transform: uppercase; letter-spacing: 0.07em; }
	.inline-link span { color: var(--acid); }

	.spell-diagram { position: relative; display: grid; align-content: end; min-height: 570px; padding: 38px; overflow: hidden; background: radial-gradient(circle at 50% 39%, rgba(62, 165, 255, 0.2), transparent 25%), linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: auto, 42px 42px, 42px 42px; }
	.spell-orb { position: absolute; top: 13%; left: 50%; width: 210px; aspect-ratio: 1; transform: translateX(-50%); border: 1px solid rgba(135, 191, 255, 0.4); border-radius: 50%; box-shadow: inset 0 0 55px rgba(76, 174, 255, 0.15), 0 0 60px rgba(76, 174, 255, 0.1); }
	.spell-orb::before, .spell-orb::after, .spell-orb span { content: ''; position: absolute; border: 1px solid rgba(135, 191, 255, 0.55); border-radius: 50%; }
	.spell-orb::before { inset: 14px 48px; transform: rotate(58deg); }
	.spell-orb::after { inset: 37px 12px; transform: rotate(-22deg); }
	.spell-orb span { inset: 65px 18px; transform: rotate(12deg); }
	.spell-orb i { position: absolute; inset: 42%; border-radius: 50%; background: #d7f1ff; box-shadow: 0 0 28px 13px #4ea9ff; }
	.spell-path { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(135, 191, 255, 0.35); }
	.spell-path div { position: relative; padding: 24px 12px 0; }
	.spell-path div::before { content: ''; position: absolute; top: -4px; left: 13px; width: 7px; height: 7px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 8px var(--blue); }
	.spell-path span, .spell-path small { display: block; color: #63757d; font: 400 8px var(--mono); }
	.spell-path strong { display: block; margin: 8px 0 5px; color: #bcd6e4; font: 500 9px var(--mono); }

	.gaze-console { position: relative; min-height: 570px; overflow: hidden; background: linear-gradient(135deg, rgba(30, 58, 45, 0.4), rgba(8, 17, 20, 0.95)); }
	.video-grid { position: absolute; inset: 0; opacity: .55; background: linear-gradient(115deg, transparent 45%, rgba(217, 255, 67, .07) 45%, rgba(217, 255, 67, .07) 46%, transparent 46%), linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: auto, 54px 54px, 54px 54px; }
	.player-box, .ball-box { position: absolute; border: 1px solid rgba(217, 255, 67, 0.72); }
	.player-box::before, .ball-box::before { content: ''; position: absolute; inset: -1px; background: linear-gradient(var(--acid), var(--acid)) top left/12px 2px no-repeat, linear-gradient(var(--acid), var(--acid)) top left/2px 12px no-repeat, linear-gradient(var(--acid), var(--acid)) bottom right/12px 2px no-repeat, linear-gradient(var(--acid), var(--acid)) bottom right/2px 12px no-repeat; }
	.player-box span, .ball-box span { position: absolute; top: -17px; left: -1px; color: var(--acid); font: 400 7px var(--mono); white-space: nowrap; }
	.box-one { top: 24%; left: 16%; width: 22%; height: 40%; }
	.box-two { top: 31%; right: 13%; width: 19%; height: 34%; opacity: .6; }
	.ball-box { top: 53%; left: 51%; width: 7%; aspect-ratio: 1; border-color: var(--orange); }
	.ball-box span { color: var(--orange); }
	.gaze-point { position: absolute; top: 49%; left: 53%; width: 66px; height: 66px; transform: translate(-50%, -50%); border: 1px solid rgba(255, 116, 72, .75); border-radius: 50%; box-shadow: 0 0 30px rgba(255, 116, 72, .28); }
	.gaze-point::before, .gaze-point::after { content: ''; position: absolute; top: 50%; left: 50%; background: var(--orange); transform: translate(-50%, -50%); }
	.gaze-point::before { width: 88px; height: 1px; }
	.gaze-point::after { width: 1px; height: 88px; }
	.gaze-point i { position: absolute; inset: 28px; border-radius: 50%; background: #fff; box-shadow: 0 0 12px var(--orange); }
	.console-label { position: absolute; color: #708178; font: 400 8px var(--mono); letter-spacing: .1em; }
	.console-label.top { top: 22px; left: 22px; }
	.console-label.bottom { right: 22px; top: 22px; color: var(--orange); }
	.metric-strip { position: absolute; right: 22px; bottom: 22px; left: 22px; display: grid; grid-template-columns: 1fr 1fr; padding: 18px; border: 1px solid rgba(217,255,67,.18); background: rgba(7, 13, 14, .78); }
	.metric-strip div { display: flex; flex-direction: column; gap: 6px; padding-left: 14px; border-left: 1px solid rgba(217,255,67,.35); }
	.metric-strip span { color: #5f706a; font: 400 7px var(--mono); }
	.metric-strip strong { color: #bdcbbf; font: 500 9px var(--mono); }

	.research-panel { display: flex; flex-direction: column; justify-content: center; gap: 28px; min-height: 570px; padding: clamp(35px, 5vw, 70px); background: linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px); background-size: 100% 44px; }
	.finding-primary { display: flex; align-items: end; gap: 18px; padding-bottom: 26px; border-bottom: 1px solid var(--line); }
	.finding-primary span { color: var(--acid); font: 600 clamp(72px, 8vw, 118px)/.75 var(--display); letter-spacing: -.08em; }
	.finding-primary p { max-width: 150px; margin: 0; color: #9ba7aa; font: 400 10px/1.5 var(--mono); text-transform: uppercase; }
	.attention-chart > p { margin: 0 0 16px; color: #657378; font: 400 8px var(--mono); letter-spacing: .1em; }
	.attention-chart div { display: grid; grid-template-columns: 92px 1fr auto; align-items: center; gap: 13px; margin: 10px 0; }
	.attention-chart span, .attention-chart strong { color: #9ba8aa; font: 400 8px var(--mono); text-transform: uppercase; }
	.attention-chart strong { color: var(--acid); }
	.attention-chart i { position: relative; height: 5px; background: rgba(255,255,255,.06); }
	.attention-chart i::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--value); background: var(--acid); box-shadow: 0 0 8px rgba(217,255,67,.25); }
	.finding-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
	.finding-row div { padding-left: 14px; border-left: 1px solid var(--orange); }
	.finding-row span { color: #e0e6e7; font: 500 17px var(--display); }
	.finding-row p { margin: 6px 0 0; color: #79878b; font-size: 10px; line-height: 1.55; }
	.method-note { margin: 0; padding-top: 19px; border-top: 1px solid var(--line); color: #647277; font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: .07em; }

	.experience { padding: 130px 0; border-top: 1px solid var(--line); }
	.section-heading.compact { margin-bottom: 60px; }
	.experience-list { margin-left: 31.8%; }
	.experience-list article { display: grid; grid-template-columns: 140px 1fr 1.6fr 200px; gap: 32px; align-items: start; padding: 34px 0; border-top: 1px solid var(--line); transition: background 180ms ease; }
	.experience-list article:hover { background: rgba(255, 255, 255, 0.015); }
	.experience-list article:last-child { border-bottom: 1px solid var(--line); }
	.period { margin: 3px 0 0; color: #6f7d81; font: 400 9px/1.55 var(--mono); text-transform: uppercase; letter-spacing: 0.05em; }
	.role h3 { margin: 0 0 5px; font: 600 18px var(--display); letter-spacing: -0.02em; color: #dce3e4; }
	.role p { margin: 0; color: var(--acid); font: 400 10px var(--mono); text-transform: uppercase; }
	.experience-copy { margin: 0; color: #9da8ab; font-size: 13px; line-height: 1.75; }
	.stack { color: #6f7d81; font: 400 9px var(--mono); text-transform: uppercase; letter-spacing: 0.04em; }

	.about { display: grid; grid-template-columns: 1fr 1.15fr 0.85fr; gap: 70px; align-items: end; padding: 90px 0; border-top: 1px solid var(--line); }
	.about h2 { margin: 15px 0 0; font: 600 clamp(36px, 4vw, 58px) var(--display); letter-spacing: -0.05em; }
	.about-copy { margin: 0; color: #96a2a5; font-size: 14px; line-height: 1.85; }
	.degree { display: flex; flex-direction: column; gap: 7px; padding-left: 20px; border-left: 2px solid var(--acid); }
	.degree strong { font: 600 14px var(--display); }
	.degree span { color: #6e7c80; font: 400 9px/1.6 var(--mono); text-transform: uppercase; }

	.contact { padding: 120px 0 45px; border-top: 1px solid var(--line); }
	.contact h2 { margin: 38px 0 16px; color: #7f8d90; font: 600 clamp(38px, 5.7vw, 82px)/1 var(--display); letter-spacing: -0.06em; }
	.contact > a { display: flex; justify-content: space-between; align-items: center; padding-bottom: 28px; border-bottom: 1px solid var(--acid); color: var(--text); font: 600 clamp(38px, 5.7vw, 82px)/1.1 var(--display); letter-spacing: -0.06em; text-decoration: none; }
	.contact > a span { color: var(--acid); font-size: 0.7em; }
	.contact-meta { display: flex; gap: 32px; margin-top: 26px; color: #6e7b7f; font: 400 9px var(--mono); text-transform: uppercase; letter-spacing: 0.07em; }
	.contact-meta a { text-decoration: none; }
	.contact-meta a:hover { color: var(--acid); }
	footer { display: flex; justify-content: space-between; width: min(1400px, calc(100% - 96px)); margin: 0 auto; padding: 30px 0; color: #4f5c60; font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: 0.1em; }

	@media (max-width: 1100px) {
		.hero { grid-template-columns: 1fr 420px; gap: 42px; }
		h1 { font-size: clamp(52px, 6.5vw, 76px); }
		.artifact { min-height: 560px; }
		.item-grid { grid-template-columns: repeat(4, 1fr); }
		.item { border-bottom: 1px solid var(--line); }
		.item:nth-child(4) { border-right: 0; }
		.item:nth-child(n+5) { border-bottom: 0; }
		.experience-list article { grid-template-columns: 105px 1fr 1.5fr; }
		.stack { grid-column: 2 / -1; }
	}

	@media (max-width: 820px) {
		.nav, .hero, .project, .selected-work, .experience, .about, .contact, footer { width: min(100% - 40px, 680px); }
		.nav nav > a:not(.nav-cta) { display: none; }
		.hero { grid-template-columns: 1fr; min-height: auto; padding: 70px 0 90px; }
		h1 { font-size: clamp(53px, 13vw, 82px); }
		.artifact { width: 100%; max-width: 560px; margin: 20px auto 0; }
		.section-heading { grid-template-columns: 1fr; gap: 35px; }
		.section-heading h2 { margin: 0; }
		.project-intro { grid-template-columns: 1fr; gap: 25px; margin-left: 0; }
		.systems { grid-template-columns: 1fr; }
		.systems article, .systems article:first-child { padding: 28px 0; border-right: 0; border-bottom: 1px solid var(--line); }
		.systems article:last-child { border-bottom: 0; }
		.systems p { min-height: auto; }
		.work-layout, .work-layout.reverse { grid-template-columns: 1fr; }
		.work-layout:not(.reverse) .work-copy, .work-layout.reverse .work-copy { border: 0; border-bottom: 1px solid var(--line); }
		.work-layout.reverse .gaze-console { order: 2; }
		.spell-diagram, .gaze-console, .research-panel { min-height: 510px; }
		.experience-list { margin-left: 0; }
		.experience-list article { grid-template-columns: 110px 1fr; }
		.experience-copy, .stack { grid-column: 2; }
		.about { grid-template-columns: 1fr; gap: 34px; align-items: start; }
		.degree { max-width: 330px; }
	}

	@media (max-width: 560px) {
		.nav { padding: 20px 0; }
		.wordmark-text { display: none; }
		.nav nav { gap: 0; }
		.hero { padding: 58px 0 72px; }
		h1 { margin-top: 22px; font-size: clamp(48px, 15vw, 67px); }
		.hero-intro { font-size: 16px; }
		.hero-actions { align-items: flex-start; flex-direction: column; gap: 22px; }
		.availability { margin-top: 44px; }
		.artifact { min-height: 480px; padding: 17px; }
		.orbit { margin-top: 20px; }
		.artifact-title { padding-top: 10px; }
		.artifact-title h2 { font-size: 29px; }
		.project { padding: 90px 0 105px; }
		.selected-work { padding: 90px 0 105px; }
		.section-heading { margin-bottom: 45px; }
		.section-heading h2 { font-size: clamp(36px, 11vw, 50px); }
		.project-intro .lead { font-size: 18px; }
		.loadout { padding: 15px; }
		.item-grid { grid-template-columns: repeat(2, 1fr); }
		.item:nth-child(2n) { border-right: 0; }
		.item:nth-child(4) { border-bottom: 1px solid var(--line); }
		.item:nth-child(5) { border-bottom: 1px solid var(--line); }
		.item:nth-child(6) { border-bottom: 1px solid var(--line); }
		.item:nth-child(7) { border-right: 1px solid var(--line); border-bottom: 0; }
		.systems { margin-top: 50px; }
		.work-list { gap: 24px; }
		.work-meta { gap: 16px; }
		.work-copy { padding: 38px 25px 43px; }
		.work-copy h3 { font-size: clamp(38px, 13vw, 56px); }
		.spell-diagram, .gaze-console, .research-panel { min-height: 430px; padding: 25px; }
		.spell-orb { top: 12%; width: 170px; }
		.spell-path div { padding: 20px 4px 0; }
		.spell-path small { display: none; }
		.metric-strip { right: 14px; bottom: 14px; left: 14px; padding: 13px; }
		.metric-strip strong { font-size: 7px; }
		.attention-chart div { grid-template-columns: 76px 1fr; }
