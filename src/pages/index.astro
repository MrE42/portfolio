---
import Layout from '../layouts/Layout.astro';

const repoAsset = 'https://raw.githubusercontent.com/MrE42/RiskOfImpact/main/icons';

const loadout = [
	{ name: 'Combo Star', type: 'Uncommon', icon: `${repoAsset}/combo_star.png`, class: 'uncommon' },
	{ name: 'Redshifter', type: 'Legendary', icon: `${repoAsset}/redshifter.png`, class: 'legendary' },
	{ name: 'Cheerful Mug', type: 'Legendary', icon: `${repoAsset}/cheerful_mug.png`, class: 'legendary' },
	{ name: 'Biotic Shell', type: 'Void', icon: `${repoAsset}/biotic_shell.png`, class: 'void' },
	{ name: 'Doomed Moon', type: 'Lunar', icon: `${repoAsset}/doomed_moon.png`, class: 'lunar' },
	{ name: 'Risky Dice', type: 'Lunar', icon: `${repoAsset}/risky_dice.png`, class: 'lunar' },
	{ name: 'Lance of Longinus', type: 'Equipment', icon: `${repoAsset}/lance_of_longinus.png`, class: 'equipment' },
];

const systems = [
	{
		index: '01',
		title: 'Runtime mechanics',
		copy: 'Event-driven item effects wired into the game loop via BepInEx hooks and IL patching. Stats recalculate dynamically as players stack items — no hard-coded values, just composable behavior.',
		tags: ['BepInEx', 'R2API', 'IL Hooks'],
	},
	{
		index: '02',
		title: 'Multiplayer authority',
		copy: 'All gameplay logic runs server-authoritative with deterministic state sync. Designed to handle desync edge cases, late joins, and the chaos of 4-player co-op without breaking.',
		tags: ['Networking', 'State Sync', 'C#'],
	},
	{
		index: '03',
		title: 'Extensible content',
		copy: 'Modular item registration with quality tiers and config-driven tuning. Built to play nice with other mods — no hardcoded dependencies, clean API boundaries.',
		tags: ['Unity', 'Config', 'Compatibility'],
	},
];

const experience = [
	{
		period: '2025 — Present',
		role: 'Applications Analyst',
		org: 'LI-COR',
		copy: 'Built internal tools for scientific data analysis and instrument parsing. Designed a multimodal RAG pipeline that lets researchers query documentation, manuals, and datasets in one place.',
		stack: 'Python · Applied AI · Data Systems',
	},
	{
		period: '2024 — 2025',
		role: 'Undergraduate Researcher',
		org: 'University of Nebraska–Lincoln',
		copy: 'Rebuilt an eye-tracking analysis pipeline from scratch. Used Sentence-BERT and behavioral clustering to study how developers comprehend APIs, then evaluated the findings with nonparametric statistics.',
		stack: 'Python · ML · Eye Tracking',
	},
	{
		period: '2024 — 2025',
		role: 'Post-Processing Lead',
		org: 'Senior Design Capstone',
		copy: 'Led backend development for a full-stack eye-tracking platform used in sports performance analysis. Built gaze and object-detection pipelines that process video data into actionable insights.',
		stack: 'Django · React · OpenCV',
	},
	{
		period: '2022 — 2023',
		role: 'Technical Lead',
		org: 'NASA SUITS',
		copy: 'Led development of AR interface software for next-gen EVA suit concepts. Presented the team’s work at Johnson Space Center to NASA engineers and program managers.',
		stack: 'Unity XR · MRTK 3 · HoloLens 2',
	},
];
---

<Layout>
	<div class="site-shell">
		<header class="nav" aria-label="Primary navigation">
			<a class="wordmark" href="#top" aria-label="Elijah Schoneweis, home">
				<span class="mark">E42</span>
				<span class="wordmark-text">Elijah Schoneweis</span>
			</a>
			<nav>
				<a href="#work">Projects</a>
				<a href="#experience">Experience</a>
				<a href="/beyond-code/">Beyond Code</a>
				<div class="nav-socials">
					<a href="https://github.com/MrE42" target="_blank" rel="noreferrer" aria-label="GitHub"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 00-3.8 23.5c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 3.8 18.3 4.1 18.3 4.1c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .3"/></svg></a>
					<a href="https://www.linkedin.com/in/elijahschoneweis" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A2.5 2.5 0 001 4.5v15A2.5 2.5 0 003.5 22h17a2.5 2.5 0 002.5-2.5v-15A2.5 2.5 0 0020.5 2zM8.1 20H4.6V10h3.5v10zm-1.7-10.8a1.9 1.9 0 110-3.8 1.9 1.9 0 010 3.8zM20 20h-3.4v-5c0-1.4-.5-2.4-1.7-2.4s-1.8 1-1.8 2.4v5H9.6V10h3.4v1.4c.5-.9 1.4-1.8 2.9-1.8 2 0 4.1 1.3 4.1 4.2v6z"/></svg></a>
				</div>
				<a class="nav-cta" href="mailto:elijahschoneweis@gmail.com">Contact <span>↗</span></a>
			</nav>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Software engineer · Lincoln, Nebraska</p>
					<h1 id="hero-title">I build systems<br />that <em>work.</em></h1>
					<p class="hero-intro">
						Multiplayer game mods, scientific data pipelines, applied AI — I design software that handles edge cases and scales when it matters.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="#project">Explore RiskOfImpact <span>↓</span></a>
						<a class="text-link" href="https://github.com/MrE42" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
					</div>
					<div class="availability">
						<div class="avatar-wrap">
							<img src="https://avatars.githubusercontent.com/u/89532300?v=4" alt="Elijah Schoneweis" width="48" height="48" />
							<span aria-hidden="true"></span>
						</div>
						<p><strong>Open to software engineering roles</strong><br />C# · Python · Full-stack · Applied AI</p>
					</div>
				</div>

				<div class="artifact" aria-label="RiskOfImpact project loadout">
					<div class="artifact-topline">
						<span>PROJECT // 001</span>
						<span class="live"><i></i> ACTIVE BUILD</span>
					</div>
					<div class="orbit" aria-hidden="true">
						<div class="ring ring-one"></div>
						<div class="ring ring-two"></div>
						<div class="crosshair horizontal"></div>
						<div class="crosshair vertical"></div>
						<div class="core">
							<img src="/riskofimpact-icon-transparent.png?v=2" alt="" width="256" height="256" />
						</div>
						<span class="orbit-label label-a">HOOKS // ARMED</span>
						<span class="orbit-label label-b">NET // AUTH</span>
					</div>
					<div class="artifact-title">
						<div>
							<p>Featured build</p>
							<h2>RiskOfImpact</h2>
						</div>
						<span class="version">v0.5.0</span>
					</div>
					<div class="artifact-stats">
						<div><span>Language</span><strong>C#</strong></div>
						<div><span>Content</span><strong>7 drops</strong></div>
						<div><span>Status</span><strong>In dev</strong></div>
					</div>
				</div>
			</section>

			<section class="project" id="project" aria-labelledby="project-title">
				<div class="section-heading">
					<p class="section-index">01 / Featured project</p>
					<h2 id="project-title">Gameplay engineering,<br /><span>from concept to edge case.</span></h2>
				</div>

				<div class="project-intro">
					<p class="lead">RiskOfImpact is a content mod for Risk of Rain 2 — built solo as a proving ground for robust, expressive gameplay systems. It adds new items and equipment that change how combat feels without breaking what already works.</p>
					<p>The real challenge wasn't adding mechanics; it was making them behave correctly in multiplayer, stay compatible with other mods, and survive the edge cases players inevitably find.</p>
				</div>

				<div class="loadout" aria-label="RiskOfImpact content">
					<div class="loadout-header">
						<span>CONTENT LOADOUT</span>
						<span>6 ITEMS + 1 EQUIPMENT</span>
					</div>
					<div class="item-grid">
						{loadout.map((item, index) => (
							<div class={`item ${item.class}`}>
								<span class="item-number">0{index + 1}</span>
								<div class="item-image"><img src={item.icon} alt="" width="86" height="86" /></div>
								<strong>{item.name}</strong>
								<span class="item-type">{item.type}</span>
							</div>
						))}
					</div>
				</div>

				<div class="systems">
					{systems.map((system) => (
						<article>
							<span class="system-index">{system.index}</span>
							<h3>{system.title}</h3>
							<p>{system.copy}</p>
							<div class="tags">{system.tags.map((tag) => <span>{tag}</span>)}</div>
						</article>
					))}
				</div>

				<a class="project-link" href="https://github.com/MrE42/RiskOfImpact" target="_blank" rel="noreferrer">
					<span>Inspect the source on GitHub</span><span class="arrow">↗</span>
				</a>
			</section>

			<section class="selected-work" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<p class="section-index">02 / Selected work</p>
					<h2 id="work-title">Different domains.<br /><span>The same systems mindset.</span></h2>
				</div>

				<div class="work-list">
					<article class="work-story rasengan-story">
						<div class="work-meta">
							<span>PROJECT // 002</span>
							<span class="released"><i></i> RELEASED · v1.0.2</span>
						</div>
						<div class="work-layout">
							<div class="work-copy">
								<p class="work-kicker">Gameplay systems · Multiplayer modding</p>
								<h3>Rasengan<wbr />Spell</h3>
								<p class="work-lead">A custom Mage Arena spell built to feel native to the game, from the page a player picks up to the spinning orb, impact, audio, and cleanup.</p>
								<p>The difficult part lived between clients. Effects needed the right owner, inventory changes had to remove only the correct player's orb, and a page could disappear without its object being disabled. I tied cleanup to the page renderer's actual lifecycle instead of a global inventory event, eliminating the host/client cross-talk.</p>
								<div class="story-tags"><span>C#</span><span>Unity</span><span>BepInEx</span><span>FishNet</span><span>AssetBundles</span></div>
								<a class="inline-link" href="https://github.com/MrE42/RasenganSpell" target="_blank" rel="noreferrer">View source <span>↗</span></a>
							</div>
							<div class="spell-diagram" aria-label="Rasengan spell lifecycle diagram">
								<div class="spell-orb"><span></span><i></i></div>
								<div class="spell-path">
									<div><span>01</span><strong>REGISTER</strong><small>Custom spell page</small></div>
									<div><span>02</span><strong>CAST</strong><small>Attach + animate</small></div>
									<div><span>03</span><strong>RESOLVE</strong><small>Collision + audio</small></div>
									<div><span>04</span><strong>CLEAN</strong><small>Owner-safe lifecycle</small></div>
								</div>
							</div>
						</div>
					</article>

					<article class="work-story gaze-story">
						<div class="work-meta">
							<span>PROJECT // 003</span>
							<span>SPONSORED SENIOR DESIGN</span>
						</div>
						<div class="work-layout reverse">
							<div class="gaze-console" aria-label="Diagram of gaze and object tracking analysis">
								<div class="video-grid"></div>
								<div class="player-box box-one"><span>PLAYER · 08</span></div>
								<div class="player-box box-two"><span>PLAYER · 14</span></div>
								<div class="ball-box"><span>BALL</span></div>
								<div class="gaze-point"><i></i></div>
								<div class="console-label top">FRAME // 01842</div>
								<div class="console-label bottom">GAZE EVENT // FIXATION</div>
								<div class="metric-strip"><div><span>PIPELINE</span><strong>VIDEO → METRICS</strong></div><div><span>TRACKING</span><strong>YOLO + BYTETRACK</strong></div></div>
							</div>
							<div class="work-copy">
								<p class="work-kicker">Computer vision · Full-stack platform</p>
								<h3>gaze<wbr />Dimension</h3>
								<p class="work-lead">A platform for turning where an athlete looks during match footage into evidence a coach can inspect.</p>
								<p>As Post-Processing Development Lead, I built the path from raw webcam gaze to a usable result: classify eye movements, track players and the ball, align both streams in time, then generate annotated video and attention metrics. The pipeline had to reconcile different clocks, coordinate systems, sampling rates, and missed detections without producing a convincing but incorrect answer.</p>
								<div class="story-tags"><span>Python</span><span>Django</span><span>React</span><span>YOLO</span><span>ByteTrack</span><span>OpenCV</span></div>
								<a class="inline-link" href="https://github.com/cseseniordesign/unl-soc-sharif" target="_blank" rel="noreferrer">View team repository <span>↗</span></a>
							</div>
						</div>
					</article>

					<article class="work-story thesis-story">
						<div class="work-meta">
							<span>RESEARCH // 004</span>
							<span>UNDERGRADUATE THESIS</span>
						</div>
						<div class="work-layout">
							<div class="work-copy">
								<p class="work-kicker">Empirical software engineering · Eye tracking</p>
								<h3>How developers read bugs.</h3>
								<p class="work-lead">Thirty developers. Raw fixation records. One question: what do people actually read when they use Bugzilla reports to understand an API?</p>
								<p>I rebuilt the analysis pipeline to map fixation XML onto individual questions, answers, and attachments. Sentence-BERT estimated which viewed ideas reached each written summary; statistical tests and behavioral clustering then separated attention patterns from intuition.</p>
								<div class="story-tags"><span>Python</span><span>Sentence-BERT</span><span>Pandas</span><span>SciPy</span><span>Eye Tracking</span></div>
							</div>
							<div class="research-panel" aria-label="Selected thesis findings">
								<div class="finding-primary"><span>30</span><p>student and professional developers</p></div>
								<div class="attention-chart">
									<p>ATTENTION BY REPORT ELEMENT</p>
									<div><span>Answers</span><i style="--value: 78%"></i><strong>largest share</strong></div>
									<div><span>Questions</span><i style="--value: 60%"></i></div>
									<div><span>Attachments</span><i style="--value: 28%"></i></div>
								</div>
								<div class="finding-row"><div><span>p = 0.001</span><p>Longer answer dwell time associated with fully correct summaries</p></div><div><span>2 patterns</span><p>Fast/selective and deep/verbose reading strategies</p></div></div>
								<p class="method-note">Fixation XML → semantic matching → nonparametric analysis</p>
							</div>
						</div>
					</article>
				</div>
			</section>

			<section class="experience" id="experience" aria-labelledby="experience-title">
				<div class="section-heading compact">
					<p class="section-index">03 / Experience log</p>
					<h2 id="experience-title">Built across <span>different worlds.</span></h2>
				</div>
				<div class="experience-list">
					{experience.map((entry) => (
						<article>
							<p class="period">{entry.period}</p>
							<div class="role"><h3>{entry.role}</h3><p>{entry.org}</p></div>
							<p class="experience-copy">{entry.copy}</p>
							<p class="stack">{entry.stack}</p>
						</article>
					))}
				</div>
			</section>

			<section class="about" aria-labelledby="about-title">
				<div>
					<p class="section-index">04 / Background</p>
					<h2 id="about-title">Built to take things apart.</h2>
				</div>
				<p class="about-copy">I like understanding how systems work — whether that's a multiplayer game mod, an eye-tracking pipeline, or why my coffee maker is acting up. When I'm not coding, I'm usually scuba diving, playing Magic: The Gathering, building something in Lego, or hunting for the best ramen in town.</p>
				<div class="degree"><strong>B.S. Computer Science</strong><span>University of Nebraska–Lincoln · 3.77 GPA · Highest University Honors · Minors in Physics & Mathematics</span></div>
			</section>

			<section class="contact" aria-labelledby="contact-title">
				<p class="section-index">05 / Get in touch</p>
				<h2 id="contact-title">Got a problem worth solving?</h2>
				<a href="mailto:elijahschoneweis@gmail.com">Let’s talk about it. <span>↗</span></a>
				<div class="contact-meta">
					<span>Lincoln, Nebraska</span>
					<a href="https://www.linkedin.com/in/elijahschoneweis" target="_blank" rel="noreferrer">LinkedIn ↗</a>
					<a href="https://github.com/MrE42" target="_blank" rel="noreferrer">GitHub ↗</a>
				</div>
			</section>
		</main>

		<footer><span>© 2026 Elijah Schoneweis</span><span>ENGINEERED WITH INTENT // E42</span></footer>
	</div>
</Layout>

<style>
	:global(:root) {
		--ink: #090d0f;
		--panel: #0e1416;
		--panel-light: #121a1d;
		--text: #e9eff0;
		--muted: #8b999d;
		--line: rgba(233, 239, 240, 0.14);
		--acid: #d9ff43;
		--orange: #ff7448;
		--blue: #87bfff;
		--mono: 'DM Mono', monospace;
		--display: 'Syne', sans-serif;
	}

	:global(html) { scroll-behavior: smooth; }

	.site-shell {
		position: relative;
		background:
			radial-gradient(circle at 74% 8%, rgba(37, 87, 90, 0.22), transparent 28rem),
			linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
			var(--ink);
		background-size: auto, 72px 72px, 72px 72px, auto;
	}

	.nav {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1400px, calc(100% - 96px));
		margin: 0 auto;
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
	}

	.wordmark { display: flex; align-items: center; gap: 13px; text-decoration: none; }
	.mark { display: grid; place-items: center; width: 37px; height: 37px; border: 1px solid var(--acid); color: var(--acid); font: 500 11px var(--mono); clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px); }
	.wordmark-text { font: 600 15px var(--display); letter-spacing: -0.02em; }
	.nav nav { display: flex; align-items: center; gap: 34px; }
	.nav nav > a:not(.nav-cta) { color: #aab5b8; font: 500 12px var(--mono); text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; transition: color 180ms ease; }
	.nav nav > a:not(.nav-cta):hover { color: var(--text); }
	.nav-socials { display: flex; align-items: center; gap: 14px; padding-left: 26px; border-left: 1px solid var(--line); }
	.nav-socials a { color: #7a898d; transition: color 180ms ease, transform 150ms ease; }
	.nav-socials a:hover { color: var(--acid); transform: translateY(-1px); }
	.nav .nav-cta { padding: 11px 15px; border: 1px solid var(--line); color: var(--text); }
	.nav-cta span { color: var(--acid); }

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(440px, 0.98fr);
		align-items: center;
		gap: clamp(52px, 7vw, 120px);
		width: min(1400px, calc(100% - 96px));
		min-height: calc(100vh - 94px);
		margin: 0 auto;
		padding: 80px 0 104px;
	}

	.eyebrow, .section-index { margin: 0; color: var(--muted); font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; }
	.eyebrow { display: flex; align-items: center; gap: 10px; }
	.eyebrow span { width: 26px; height: 1px; background: var(--acid); box-shadow: 0 0 10px rgba(217, 255, 67, 0.5); }
	h1 { max-width: 800px; margin: 25px 0 24px; font: 600 clamp(54px, 6.25vw, 102px)/0.91 var(--display); letter-spacing: -0.065em; }
	h1 em { color: var(--acid); font-style: normal; }
	.hero-intro { max-width: 620px; margin: 0; color: #aab5b8; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.65; }
	.hero-actions { display: flex; align-items: center; gap: 30px; margin-top: 38px; }
	.button { display: inline-flex; align-items: center; gap: 28px; padding: 16px 18px; text-decoration: none; font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
	.button.primary { background: var(--acid); color: var(--ink); clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px)); transition: transform 180ms ease, background 180ms ease; }
	.button.primary:hover { background: #ebff98; transform: translateY(-2px); }
	.text-link { color: #c4cdcf; font: 500 12px var(--mono); text-decoration-color: #536063; text-underline-offset: 7px; text-transform: uppercase; }
	.text-link span { color: var(--acid); }
	.availability { display: flex; align-items: center; gap: 14px; margin-top: 54px; }
	.avatar-wrap { position: relative; }
	.avatar-wrap img { display: block; border-radius: 50%; filter: grayscale(0.15); }
	.avatar-wrap span { position: absolute; right: 0; bottom: 0; width: 12px; height: 12px; border: 2px solid var(--ink); border-radius: 50%; background: var(--acid); }
	.availability p { margin: 0; color: #68777b; font: 400 11px/1.65 var(--mono); text-transform: uppercase; letter-spacing: 0.04em; }
	.availability strong { color: #b8c2c4; font-weight: 500; }

	.artifact { position: relative; min-height: 620px; padding: 23px; overflow: hidden; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(25, 37, 40, 0.92), rgba(9, 13, 15, 0.96)); clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%); box-shadow: 0 40px 100px rgba(0, 0, 0, 0.35); }
	.artifact::before { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(217, 255, 67, 0.035), transparent 65%); transform: translateX(-80%); animation: scan 7s linear infinite; }
	@keyframes scan { to { transform: translateX(80%); } }
	.artifact-topline, .loadout-header { position: relative; z-index: 2; display: flex; justify-content: space-between; color: #6d7b7f; font: 500 9px var(--mono); letter-spacing: 0.14em; }
	.live { color: #b7c2c4; }
	.live i { display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 9px var(--acid); }
	.orbit { position: relative; display: grid; place-items: center; width: min(100%, 460px); aspect-ratio: 1; margin: 24px auto 5px; }
	.ring { position: absolute; border: 1px solid rgba(233, 239, 240, 0.16); border-radius: 50%; }
	.ring-one { inset: 8%; border-style: dashed; animation: rotate 30s linear infinite; }
	.ring-two { inset: 20%; border-color: rgba(217, 255, 67, 0.23); }
	.ring-one::before, .ring-one::after { content: ''; position: absolute; width: 9px; height: 9px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 12px var(--acid); }
	.ring-one::before { left: 12%; top: 12%; }
	.ring-one::after { right: 4%; bottom: 25%; background: var(--orange); box-shadow: 0 0 12px var(--orange); }
	@keyframes rotate { to { transform: rotate(360deg); } }
	.crosshair { position: absolute; background: rgba(233, 239, 240, 0.09); }
	.crosshair.horizontal { width: 100%; height: 1px; }
	.crosshair.vertical { width: 1px; height: 100%; }
	.core { position: relative; z-index: 2; display: grid; place-items: center; width: 36%; aspect-ratio: 1; background: transparent; }
	.core img { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.5)); }
	.orbit-label { position: absolute; padding: 5px 7px; background: var(--panel); color: #829095; font: 400 8px var(--mono); letter-spacing: 0.09em; }
	.label-a { top: 18%; left: 4%; }
	.label-b { right: 0; bottom: 23%; }
	.artifact-title { display: flex; align-items: end; justify-content: space-between; padding: 24px 2px 20px; border-bottom: 1px solid var(--line); }
	.artifact-title p { margin: 0 0 3px; color: var(--orange); font: 500 9px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; }
	.artifact-title h2 { margin: 0; font: 600 clamp(30px, 3vw, 43px) var(--display); letter-spacing: -0.04em; }
	.version { color: #849196; font: 400 11px var(--mono); }
	.artifact-stats { display: grid; grid-template-columns: repeat(3, 1fr); padding-top: 19px; }
	.artifact-stats div { display: flex; flex-direction: column; gap: 4px; padding-left: 16px; border-left: 1px solid var(--line); }
	.artifact-stats span { color: #667478; font: 400 8px var(--mono); text-transform: uppercase; letter-spacing: 0.1em; }
	.artifact-stats strong { color: #cbd3d5; font: 500 12px var(--mono); text-transform: uppercase; }

	.project, .selected-work, .experience, .about, .contact { width: min(1400px, calc(100% - 96px)); margin: 0 auto; }
	.project { padding: 130px 0 145px; border-top: 1px solid var(--line); }
